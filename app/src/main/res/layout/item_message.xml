<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:textSize="15sp"
        android:textColor="#EEECFF"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:lineSpacingExtra="4dp"
        android:letterSpacing="0.01"
        android:elevation="1dp" />

    <TextView
        android:id="@+id/repeatButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#128257; Repeat"
        android:textColor="#5B5678"
        android:textSize="11sp"
        android:paddingStart="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/correctionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#C4B5FD"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bubble_correction"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="60dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/suggestionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#A5B4FC"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bubble_suggestion"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="60dp"
        android:visibility="gone" />

</LinearLayout>
