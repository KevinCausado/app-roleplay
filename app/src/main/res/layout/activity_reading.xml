<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080616">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0D0A1C">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#5B5678"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Reading"
            android:textColor="#F5F3FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/readingSpeakBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Read"
            android:textColor="#A78BFA"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bubble_correction"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <EditText
        android:id="@+id/readingInput"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#100C24"
        android:textColor="#E8E6FF"
        android:textColorHint="#3D3860"
        android:hint="Paste any English text here..."
        android:padding="16dp"
        android:textSize="14sp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/readingLoadBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load text"
        android:textColor="#F5F3FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="#7C3AED"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:id="@+id/readingScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E2DFF5"
            android:textSize="16sp"
            android:lineSpacingExtra="8dp" />

    </ScrollView>

</LinearLayout>
