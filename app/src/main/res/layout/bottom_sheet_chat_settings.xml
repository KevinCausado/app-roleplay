<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12121A"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Font Size"
        android:textColor="#9999BB"
        android:textSize="13sp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp" />

    <SeekBar
        android:id="@+id/fontSizeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:progressTint="#7B5EA7"
        android:thumbTint="#7B5EA7" />

    <TextView
        android:id="@+id/fontPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:textColor="#DDDDFF"
        android:background="#1A1A2E"
        android:text="She smiles at you. Hey, you okay?"
        android:lineSpacingExtra="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A2E"
        android:layout_marginVertical="16dp"
        android:layout_marginHorizontal="20dp" />

    <TextView
        android:id="@+id/bgWorldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9999BB"
        android:textSize="13sp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:text="Background for: Modern" />

    <Button
        android:id="@+id/changeBgButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:text="Choose image from gallery"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:backgroundTint="#7B5EA7" />

</LinearLayout>
